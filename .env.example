# ==============================================================================
# AgentFeed Environment Configuration Template
# 复制此文件为 .env 并按需填写您的服务凭据与存储配置
# ==============================================================================

# ---------- 1. Cloudflare R2 / S3 兼容全球 CDN 静态发布 ----------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ENDPOINT_URL=""
R2_BUCKET_NAME="agentfeed-public"
# 绑定您的公开域名或 Workers 域名（例如: https://feed.yourcompany.com）
R2_PUBLIC_DOMAIN="https://feed.your-domain.com"

# ---------- 2. RSSHub 节点池配置 ----------
RSSHUB_PRIMARY="https://rsshub.app"
RSSHUB_BACKUP="https://rsshub.rssforever.com"

# ---------- 3. 大模型 LLM 接口凭据 (可选，未配置将自动启用本地规则引擎/电脑Agent) ----------
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
DEEPSEEK_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

# ---------- 4. 飞书开放平台凭据 (用于自动创建飞书云文档) ----------
FEISHU_APP_ID=""
FEISHU_APP_SECRET=""
FEISHU_FOLDER_TOKEN=""
FEISHU_WEBHOOK_URL=""

# ---------- 5. 邮件分发 (SMTP 服务) ----------
SMTP_HOST="smtp.qq.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
SMTP_RECIPIENTS=""

# ---------- 6. 服务端口与主机 ----------
AGENTFEED_HOST="127.0.0.1"
AGENTFEED_PORT=9830
